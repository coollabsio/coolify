{
  "manifest_version": 3,
  "name": "Privacy Sentinel",
  "version": "1.0",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "webRequest",
    "webNavigation",
    "privacy"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "host_permissions": ["<all_urls>"]
}
