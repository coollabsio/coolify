{
    "name": "coolify",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
        "test:e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
        "test:e2e:exploratory": "node ./node_modules/@playwright/test/cli.js test tests/e2e/exploratory.spec.ts",
        "test:e2e:smoke": "node ./node_modules/@playwright/test/cli.js test tests/e2e/smoke.spec.ts",
        "test:e2e:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile e2e run --rm e2e"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.0",
        "@tailwindcss/postcss": "4.1.18",
        "@vitejs/plugin-vue": "6.0.3",
        "axios": "1.13.2",
        "laravel-echo": "2.2.7",
        "laravel-vite-plugin": "2.0.1",
        "postcss": "8.5.6",
        "pusher-js": "8.4.0",
        "tailwind-scrollbar": "4.0.2",
        "tailwindcss": "4.1.18",
        "vite": "7.3.0",
        "vue": "3.5.26"
    },
    "dependencies": {
        "@tailwindcss/forms": "0.5.10",
        "@tailwindcss/typography": "0.5.16",
        "@xterm/addon-fit": "0.10.0",
        "@xterm/xterm": "5.5.0",
        "ioredis": "5.6.1"
    }
}