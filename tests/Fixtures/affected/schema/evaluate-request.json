{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://coolify.io/schemas/coolify-affected/v1/evaluate-request.json",
	"title": "coolify-affected evaluate request (schema_version 1)",
	"type": "object",
	"required": [
		"schema_version",
		"repository",
		"after",
		"applications"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"repository": {
			"type": "object",
			"required": [
				"url",
				"mirror_key"
			],
			"properties": {
				"url": {
					"type": "string",
					"description": "https://, http://, ssh:// or scp-like git@host:path. file:// and ext:: are rejected."
				},
				"mirror_key": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				},
				"git_env": {
					"type": [
						"object",
						"null"
					],
					"additionalProperties": {
						"type": "string"
					}
				},
				"git_config": {
					"type": [
						"array",
						"null"
					],
					"items": {
						"type": "string",
						"pattern": "^[^=\\n\\r]+=[^\\n\\r]*$"
					}
				},
				"submodules": {
					"type": "boolean"
				}
			}
		},
		"after": {
			"$ref": "common.json#/$defs/sha"
		},
		"fetch_refs": {
			"type": [
				"array",
				"null"
			],
			"maxItems": 100,
			"items": {
				"$ref": "common.json#/$defs/ref"
			}
		},
		"is_fork": {
			"type": "boolean"
		},
		"applications": {
			"type": "array",
			"maxItems": 10000,
			"items": {
				"$ref": "common.json#/$defs/application"
			}
		},
		"limits": {
			"type": "object",
			"description": "0 or a missing field means the default.",
			"properties": {
				"timeout_seconds": {
					"type": "integer",
					"minimum": 0,
					"maximum": 3600,
					"default": 120
				},
				"max_changed_files": {
					"type": "integer",
					"minimum": 0,
					"default": 50000
				},
				"max_manifest_files": {
					"type": "integer",
					"minimum": 0,
					"default": 5000
				},
				"max_manifest_bytes": {
					"type": "integer",
					"minimum": 0,
					"default": 52428800
				},
				"max_mirror_bytes": {
					"type": "integer",
					"minimum": 0,
					"default": 10737418240
				},
				"max_reported_files": {
					"type": "integer",
					"minimum": 0,
					"default": 200
				}
			}
		}
	}
}
