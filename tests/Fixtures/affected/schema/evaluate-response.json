{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://coolify.io/schemas/coolify-affected/v1/evaluate-response.json",
	"title": "coolify-affected evaluate response (schema_version 1)",
	"type": "object",
	"required": [
		"schema_version",
		"tool_version",
		"after",
		"timings_ms",
		"diffs",
		"applications",
		"errors"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"tool_version": {
			"type": "string"
		},
		"after": {
			"$ref": "common.json#/$defs/sha"
		},
		"timings_ms": {
			"$ref": "common.json#/$defs/timings"
		},
		"diffs": {
			"type": "object",
			"propertyNames": {
				"$ref": "common.json#/$defs/sha"
			},
			"additionalProperties": {
				"type": "object",
				"required": [
					"status",
					"changed_files_count",
					"changed_files_truncated",
					"changed_files"
				],
				"properties": {
					"status": {
						"enum": [
							"ok",
							"base_unreachable",
							"too_many_changes",
							"error"
						]
					},
					"relation": {
						"enum": [
							"ancestor",
							"identical",
							"diverged",
							"unrelated"
						]
					},
					"changed_files_count": {
						"type": "integer",
						"minimum": 0
					},
					"changed_files_truncated": {
						"type": "boolean"
					},
					"changed_files": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"error": {
						"type": "string"
					}
				},
				"additionalProperties": false
			}
		},
		"applications": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"decision",
					"reason_code",
					"reason",
					"base",
					"matches"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"decision": {
						"enum": [
							"deploy",
							"skip"
						]
					},
					"reason_code": {
						"enum": [
							"matched",
							"watch_paths_matched",
							"no_match",
							"watch_paths_no_match",
							"no_base",
							"base_unreachable",
							"empty_diff",
							"too_many_changes",
							"fork_no_narrowing",
							"resolution_failed",
							"timeout",
							"error"
						]
					},
					"reason": {
						"type": "string"
					},
					"base": {
						"anyOf": [
							{
								"$ref": "common.json#/$defs/sha"
							},
							{
								"type": "null"
							}
						]
					},
					"matches": {
						"type": "array",
						"maxItems": 20,
						"items": {
							"type": "object",
							"required": [
								"file",
								"rule"
							],
							"properties": {
								"file": {
									"type": "string"
								},
								"rule": {
									"enum": [
										"workspace",
										"global",
										"reference",
										"managed_config",
										"lockfile",
										"build_context",
										"dockerfile",
										"compose",
										"watch_paths"
									]
								},
								"via": {
									"type": "array",
									"items": {
										"type": "string"
									}
								}
							},
							"additionalProperties": false
						}
					},
					"lockfile": {
						"type": "object",
						"required": [
							"files",
							"affects_app",
							"detail"
						],
						"properties": {
							"files": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"affects_app": {
								"type": "boolean"
							},
							"detail": {
								"type": "string"
							}
						},
						"additionalProperties": false
					},
					"trigger_set": {
						"$ref": "common.json#/$defs/trigger_set"
					}
				},
				"allOf": [
					{
						"if": {
							"properties": {
								"decision": {
									"const": "skip"
								}
							}
						},
						"then": {
							"properties": {
								"reason_code": {
									"enum": [
										"no_match",
										"watch_paths_no_match"
									]
								},
								"matches": {
									"maxItems": 0
								}
							}
						}
					},
					{
						"if": {
							"properties": {
								"decision": {
									"const": "deploy"
								}
							}
						},
						"then": {
							"properties": {
								"reason_code": {
									"not": {
										"enum": [
											"no_match",
											"watch_paths_no_match"
										]
									}
								}
							}
						}
					}
				],
				"additionalProperties": false
			}
		},
		"errors": {
			"type": "array",
			"items": {
				"type": "string"
			}
		}
	},
	"additionalProperties": false
}
