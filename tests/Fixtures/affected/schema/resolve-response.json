{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://coolify.io/schemas/coolify-affected/v1/resolve-response.json",
	"title": "coolify-affected resolve response (schema_version 1)",
	"type": "object",
	"required": [
		"schema_version",
		"tool_version",
		"commit",
		"graph",
		"applications",
		"errors",
		"timings_ms"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"tool_version": {
			"type": "string"
		},
		"commit": {
			"type": "string"
		},
		"graph": {
			"type": "object",
			"required": [
				"packages",
				"globals",
				"lockfiles",
				"resolvers",
				"widened",
				"not_modeled"
			],
			"properties": {
				"packages": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"dir",
							"resolvers"
						],
						"properties": {
							"dir": {
								"type": "string"
							},
							"names": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"resolvers": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"manifests": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"deps": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"dep_dirs": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"lifecycle": {
								"type": "boolean"
							}
						}
					}
				},
				"globals": {
					"type": "array"
				},
				"lockfiles": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"resolvers": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"widened": {
					"type": [
						"array",
						"null"
					],
					"items": {
						"$ref": "common.json#/$defs/widen"
					}
				},
				"not_modeled": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"applications": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"trigger_set"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"trigger_set": {
						"$ref": "common.json#/$defs/trigger_set"
					}
				},
				"additionalProperties": false
			}
		},
		"errors": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"timings_ms": {
			"$ref": "common.json#/$defs/timings"
		}
	},
	"additionalProperties": false
}
