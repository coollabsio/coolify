{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://coolify.io/schemas/coolify-affected/v1/resolve-request.json",
	"title": "coolify-affected resolve request (schema_version 1)",
	"description": "Resolve a checkout (worktree, commit optional) or a commit of a mirror (mirror_key and commit).",
	"type": "object",
	"required": [
		"schema_version",
		"applications"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"worktree": {
			"type": "string",
			"pattern": "^/"
		},
		"mirror_key": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"commit": {
			"$ref": "common.json#/$defs/sha"
		},
		"applications": {
			"type": "array",
			"items": {
				"$ref": "common.json#/$defs/application"
			}
		},
		"limits": {
			"type": "object"
		}
	},
	"oneOf": [
		{
			"required": [
				"worktree"
			],
			"not": {
				"required": [
					"mirror_key"
				]
			}
		},
		{
			"required": [
				"mirror_key",
				"commit"
			],
			"not": {
				"required": [
					"worktree"
				]
			}
		}
	]
}
