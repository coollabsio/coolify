{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://coolify.io/schemas/coolify-affected/v1/scan-response.json",
	"title": "coolify-affected scan response (schema_version 1)",
	"description": "A non-empty widened with empty reference_paths means the scan is not valid: Coolify deploys on the next push.",
	"type": "object",
	"required": [
		"schema_version",
		"tool_version",
		"commit",
		"reference_paths",
		"evidence",
		"widened",
		"timings_ms"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"tool_version": {
			"type": "string"
		},
		"commit": {
			"$ref": "common.json#/$defs/sha"
		},
		"reference_paths": {
			"type": "array",
			"items": {
				"$ref": "common.json#/$defs/path"
			}
		},
		"evidence": {
			"type": "array",
			"maxItems": 50,
			"items": {
				"type": "object",
				"required": [
					"from",
					"to"
				],
				"properties": {
					"from": {
						"type": "string"
					},
					"to": {
						"type": "string"
					}
				},
				"additionalProperties": false
			}
		},
		"widened": {
			"type": "array",
			"items": {
				"$ref": "common.json#/$defs/widen"
			}
		},
		"timings_ms": {
			"$ref": "common.json#/$defs/timings"
		}
	},
	"additionalProperties": false
}
