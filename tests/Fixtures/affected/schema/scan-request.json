{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://coolify.io/schemas/coolify-affected/v1/scan-request.json",
	"title": "coolify-affected scan request (schema_version 1)",
	"type": "object",
	"required": [
		"schema_version",
		"worktree",
		"commit",
		"application"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"worktree": {
			"type": "string",
			"pattern": "^/"
		},
		"commit": {
			"$ref": "common.json#/$defs/sha"
		},
		"application": {
			"$ref": "common.json#/$defs/application"
		},
		"limits": {
			"type": "object",
			"properties": {
				"timeout_seconds": {
					"type": "integer",
					"minimum": 0,
					"maximum": 3600,
					"default": 60
				},
				"max_files": {
					"type": "integer",
					"minimum": 0,
					"default": 100000
				},
				"max_file_bytes": {
					"type": "integer",
					"minimum": 0,
					"default": 1048576
				}
			}
		}
	}
}
