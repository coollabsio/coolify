{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://coolify.io/schemas/coolify-affected/v1/common.json",
	"title": "coolify-affected shared definitions (schema_version 1)",
	"$defs": {
		"sha": {
			"type": "string",
			"pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
		},
		"ref": {
			"type": "string",
			"pattern": "^refs/[A-Za-z0-9._/+-]+$"
		},
		"path": {
			"description": "A repository-relative path. A leading / is allowed and stripped; .. segments and NUL bytes are not.",
			"type": "string",
			"not": {
				"pattern": "(^|/)\\.\\.(/|$)|\\x00"
			}
		},
		"nullable_string": {
			"type": [
				"string",
				"null"
			]
		},
		"widen": {
			"type": "object",
			"required": [
				"scope",
				"reason"
			],
			"properties": {
				"scope": {
					"type": "string"
				},
				"reason": {
					"type": "string"
				}
			},
			"additionalProperties": false
		},
		"timings": {
			"type": "object",
			"additionalProperties": {
				"type": "integer",
				"minimum": 0
			}
		},
		"application": {
			"type": "object",
			"required": [
				"id",
				"mode",
				"build_pack",
				"base_directory"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[A-Za-z0-9._:-]{1,128}$"
				},
				"base_commit": {
					"anyOf": [
						{
							"$ref": "#/$defs/sha"
						},
						{
							"type": "null"
						}
					]
				},
				"merge_base_ref": {
					"anyOf": [
						{
							"$ref": "#/$defs/ref"
						},
						{
							"type": "null"
						}
					]
				},
				"mode": {
					"enum": [
						"smart",
						"watch_paths"
					]
				},
				"watch_paths": {
					"$ref": "#/$defs/nullable_string"
				},
				"build_pack": {
					"enum": [
						"dockerfile",
						"dockercompose",
						"railpack",
						"nixpacks",
						"static"
					]
				},
				"base_directory": {
					"$ref": "#/$defs/path"
				},
				"dockerfile_location": {
					"anyOf": [
						{
							"$ref": "#/$defs/path"
						},
						{
							"type": "null"
						}
					]
				},
				"docker_compose_location": {
					"anyOf": [
						{
							"$ref": "#/$defs/path"
						},
						{
							"type": "null"
						}
					]
				},
				"commands": {
					"type": "object",
					"properties": {
						"install": {
							"$ref": "#/$defs/nullable_string"
						},
						"build": {
							"$ref": "#/$defs/nullable_string"
						},
						"start": {
							"$ref": "#/$defs/nullable_string"
						},
						"compose_build": {
							"$ref": "#/$defs/nullable_string"
						},
						"compose_start": {
							"$ref": "#/$defs/nullable_string"
						}
					}
				},
				"reference_paths": {
					"type": [
						"array",
						"null"
					],
					"items": {
						"$ref": "#/$defs/path"
					}
				},
				"managed_config_paths": {
					"type": [
						"array",
						"null"
					],
					"items": {
						"$ref": "#/$defs/path"
					}
				}
			}
		},
		"rule": {
			"type": "object",
			"required": [
				"action",
				"kind"
			],
			"properties": {
				"action": {
					"enum": [
						"include",
						"exclude"
					]
				},
				"kind": {
					"enum": [
						"dir",
						"file",
						"glob"
					]
				},
				"path": {
					"type": "string",
					"minLength": 1
				},
				"pattern": {
					"type": "string",
					"minLength": 1
				}
			},
			"oneOf": [
				{
					"properties": {
						"kind": {
							"enum": [
								"dir",
								"file"
							]
						}
					},
					"required": [
						"path"
					],
					"not": {
						"required": [
							"pattern"
						]
					}
				},
				{
					"properties": {
						"kind": {
							"const": "glob"
						}
					},
					"required": [
						"pattern"
					],
					"not": {
						"required": [
							"path"
						]
					}
				}
			],
			"additionalProperties": false
		},
		"compiled_set": {
			"description": "A path matches when every ruleset includes it. In a ruleset the last matching rule wins; with no match, default decides. dir matches the path and everything under it; file matches exactly; glob: * is any run except /, ** as a whole segment is zero or more segments, ? is one character except /.",
			"type": "object",
			"required": [
				"version",
				"all_of",
				"lockfiles"
			],
			"properties": {
				"version": {
					"const": 1
				},
				"all_of": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"limit",
							"default",
							"rules"
						],
						"properties": {
							"limit": {
								"type": "string"
							},
							"default": {
								"enum": [
									"include",
									"exclude"
								]
							},
							"rules": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/rule"
								}
							}
						},
						"additionalProperties": false
					}
				},
				"lockfiles": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"anchor": {
			"type": "object",
			"required": [
				"resolver",
				"package",
				"dir",
				"source"
			],
			"properties": {
				"resolver": {
					"type": "string"
				},
				"package": {
					"type": "string"
				},
				"dir": {
					"type": "string"
				},
				"source": {
					"enum": [
						"dockerfile_location",
						"compose",
						"base_directory",
						"commands"
					]
				}
			},
			"additionalProperties": false
		},
		"trigger_set": {
			"type": "object",
			"required": [
				"compiled",
				"display",
				"limits",
				"resolvers",
				"anchor",
				"anchors",
				"widened",
				"manifest_fingerprint",
				"input_patterns"
			],
			"properties": {
				"compiled": {
					"$ref": "#/$defs/compiled_set"
				},
				"display": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"limits": {
					"type": "array",
					"items": {
						"enum": [
							"build_context",
							"dockerfile",
							"compose",
							"workspace"
						]
					}
				},
				"resolvers": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"anchor": {
					"anyOf": [
						{
							"$ref": "#/$defs/anchor"
						},
						{
							"type": "null"
						}
					]
				},
				"anchors": {
					"type": [
						"array",
						"null"
					],
					"items": {
						"$ref": "#/$defs/anchor"
					}
				},
				"widened": {
					"type": [
						"array",
						"null"
					],
					"items": {
						"$ref": "#/$defs/widen"
					}
				},
				"manifest_fingerprint": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$"
				},
				"input_patterns": {
					"description": "Every path whose change can alter this trigger set: what the resolvers and limits read, what they would read if it were added, the tracked symlinks and the base directory. When no changed file of a push matches it (and no lockfile changed), the stored trigger set is still valid. A push that matches the trigger set (a deploy) can add a symlink inside the set, whose target the stored set does not follow: re-evaluate the set after such a push.",
					"$ref": "#/$defs/compiled_set"
				}
			},
			"additionalProperties": false
		},
		"error_document": {
			"description": "What stdout carries with exit code 2 (invalid input) or 3 (fatal failure).",
			"type": "object",
			"required": [
				"schema_version",
				"tool_version",
				"error"
			],
			"properties": {
				"schema_version": {
					"const": 1
				},
				"tool_version": {
					"type": "string"
				},
				"error": {
					"type": "object",
					"required": [
						"code",
						"message"
					],
					"properties": {
						"code": {
							"enum": [
								"invalid_input",
								"fatal"
							]
						},
						"message": {
							"type": "string"
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		}
	}
}
