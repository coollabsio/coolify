{{- range .Matches }}
{{- $sugg := "" }}{{- range .MatchDetails }}{{- if and (not $sugg) .Fix }}{{- if .Fix.SuggestedVersion }}{{- $sugg = .Fix.SuggestedVersion }}{{- end }}{{- end }}{{- end }}
{{- $rel := list }}{{- range .RelatedVulnerabilities }}{{- $rel = append $rel .ID }}{{- end }}
{{- $m := dict "id" .Vulnerability.ID "rel" $rel "sev" .Vulnerability.Severity "pkg" .Artifact.Name "ver" .Artifact.Version "type" .Artifact.Type "art" .Artifact.ID "fix" .Vulnerability.Fix.State "fixv" .Vulnerability.Fix.Versions "kev" (ne (len .Vulnerability.KnownExploited) 0) "risk" .Vulnerability.Risk "desc" (.Vulnerability.Description | trunc 300) }}
{{- if $sugg }}{{- $_ := set $m "sugg" $sugg }}{{- end }}
{{- if .Vulnerability.EPSS }}{{- $_ := set $m "epss" (first .Vulnerability.EPSS).EPSS }}{{- end }}
{{ toJson $m }}
{{- end }}
{{- $eol := dict }}
{{- range .AlertsByPackage }}{{- range .Alerts }}{{- if and (eq .Type "distro-eol") (not $eol) }}{{- $eol = dict "name" .Metadata.Name "version" .Metadata.Version }}{{- end }}{{- end }}{{- end }}
{{ if $eol }}{{ dict "eol" $eol | toJson }}{{ else }}{"eol":null}{{ end }}
